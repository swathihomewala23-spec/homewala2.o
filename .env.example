# Leave this as /api to use the Vite dev proxy, or set the deployed Laravel API URL.
VITE_API_URL=/api/

# Laravel origin used by the Vite development proxy.
VITE_BACKEND_URL=http://localhost:8000

# HOCO uses the same Laravel API base URL as the rest of the frontend.
# Its intent parser is deterministic and does not call an external AI provider.
